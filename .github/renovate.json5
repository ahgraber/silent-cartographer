{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
    'helpers:pinGitHubActionDigestsToSemver',
    ':automergePr',
    ':configMigration',
    ':dependencyDashboard',
    ':disableRateLimiting',
    ':enablePreCommit',
    ':renovatePrefix',
    ':semanticCommits',
    ':separateMultipleMajorReleases',
    ':separateMultipleMinorReleases',
    ':separatePatchReleases',
    ':timezone(America/New_York)',
    'github>ninerealmlabs/precommit-template//.github/renovate/autoMerge.json5',
    'github>ninerealmlabs/precommit-template//.github/renovate/customManagers.json5',
    'github>ninerealmlabs/precommit-template//.github/renovate/labels.json5',
    'github>ninerealmlabs/precommit-template//.github/renovate/packageRules.json5',
    'github>ninerealmlabs/precommit-template//.github/renovate/semanticCommits.json5',
  ],
  dependencyDashboard: {
    title: 'Renovate Dashboard 🤖',
  },
  suppressNotifications: [
    'prEditedNotification',
    'prIgnoreNotification',
  ],
  schedule: [
    'before 5am',
  ],
  minimumReleaseAge: '3 days',
  ignorePaths: [
    'tests/fixtures/**',
  ],
  packageRules: [
    {
      description: [
        'Group the Rust crates into one PR per update type',
      ],
      matchManagers: [
        'cargo',
      ],
      semanticCommitScope: 'deps',
    },
    {
      description: [
        'Never auto-merge the exact-pinned crates',
      ],
      matchManagers: [
        'cargo',
      ],
      matchPackageNames: [
        'protobuf',
        'sqlite-vec',
        'model2vec-rs',
        'tokenizers',
      ],
      automerge: false,
      addLabels: [
        'review/manual',
      ],
    },
    {
      description: [
        'Separate the Python subprojects from the Rust crate',
      ],
      matchManagers: [
        'pep621',
      ],
      semanticCommitScope: 'python-deps',
    },
  ],
}

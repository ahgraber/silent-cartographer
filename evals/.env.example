# Configuration for eval sweeps.
#
# Copy to `.env`. direnv loads it on `cd`, and `just` loads it for shells where direnv
# is not active. `.env` is gitignored; keep the token out of every other file.
#
# Every value here is baked into the arm configs at render time. After changing any of
# them, run `just config` before the next sweep, or the sweep uses the old value.
# `just env-check` prints what is set and fails on a missing required value.


# --- endpoint ----------------------------------------------------------------

# [Required] The inference endpoint URL, reachable from inside a trial container.
# `localhost` names the container itself, so use a hostname the container can resolve.
# The endpoint must speak the Anthropic Messages API with streaming and tool use, and
# it must report usage token counts. The cost metric comes from those counts.
EVAL_PROXY_BASE_URL=""

# [Required] Bearer token for the endpoint.
# Rendered configs hold the literal `${EVAL_PROXY_TOKEN}`. Pier resolves it when the
# sweep starts, so the secret never lands in a config file.
EVAL_PROXY_TOKEN=""

# [Required] The model the endpoint serves, recorded once per sweep.
# Because a base URL is set, Pier pins every Claude Code model alias to this name, so
# the endpoint never sees another.
EVAL_MODEL_NAME=""


# --- episode bounds ----------------------------------------------------------
# Four limits on one episode. The first one reached ends it.

# Turn cap per episode. Code default 40.
# Episodes reach 17-21 turns before the timeout below ends them, so this cap rarely
# binds.
EVAL_MAX_TURNS="40"

# Spend cap per episode, in USD. Code default 2.0. Set 0 to remove the cap.
# Claude Code prices an episode from its own table, keyed to the model name it sees. A
# locally served model reports zero cost, so this cap never binds.
EVAL_MAX_BUDGET_USD="0"

# Wall-clock limit for one episode, in seconds. Code default 1200.
# Without it, Pier waits on the agent indefinitely. Exceeding this limit raises
# AgentTimeoutError, which the importer records as an agent failure and scores as an
# empty answer.
# Set it from the decode rate at your chosen concurrency, not from a solo measurement.
# It should almost never end a healthy episode: at 1200 it ended 52% of them, and those
# episodes were still opening new files when it fired.
EVAL_AGENT_TIMEOUT_SEC="3600"

# Token limit on one model response. Code default 8000.
# Passed to Claude Code as CLAUDE_CODE_MAX_OUTPUT_TOKENS, whose own default is 32000.
# A lower ceiling ends a runaway response sooner. Set it too low, and a long list gets
# cut mid-item; the next response restarts the list instead of resuming it.
EVAL_MAX_OUTPUT_TOKENS="8000"


# --- throughput --------------------------------------------------------------

# Trials in flight within one arm. Code default 3. Each trial is a container.
# A batching endpoint serves several requests at once, so raising this raises total
# throughput and slows each request. Keep it at or below the endpoint's batch size, and
# set the agent timeout from the per-request rate at this concurrency.
EVAL_CONCURRENCY="3"


# --- results -----------------------------------------------------------------

# Where imported trials are stored. Code default `sqlite:///mlflow.db`.
# A relative sqlite path resolves against this directory, where every recipe runs.
# The importer writes the file directly, so `just ingest` and `just analyze` need no
# server. `just mlflow` serves the same file for reading.
MLFLOW_TRACKING_URI="sqlite:///mlflow.db"


# --- must stay unset ---------------------------------------------------------
# Pier reads Claude Code credentials from the host when the config does not supply
# them, and copies them into the trial container. Any of these is used ahead of the
# proxy, so the sweep silently runs against the wrong endpoint.
# `just env-check` fails when it finds one set.
#
#   ANTHROPIC_API_KEY
#   ANTHROPIC_AUTH_TOKEN
#   CLAUDE_CODE_OAUTH_TOKEN
#
# The renderer writes ANTHROPIC_BASE_URL and ANTHROPIC_AUTH_TOKEN into the arm configs.
# Setting ANTHROPIC_BASE_URL on the host adds nothing and can disagree with the render.

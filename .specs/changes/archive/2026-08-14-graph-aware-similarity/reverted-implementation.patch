+//! The graph similarity signal: corpus symbols ranked by how much of a subject's dependency
+//! neighborhood they occupy, damped so that ubiquity never reads as similarity.
+//!
+//! Two symbols are structural siblings when the codebase wires them the same way — co-called
+//! functions share their callers, parallel implementations share the types they are threaded
+//! through. The signal measures that as overlap between one-hop dependency neighborhoods
+//! (`uses`/`imports`/`type_hierarchy`, both directions), a shared-neighbor measure with long
+//! code-domain precedent.
+//!
+//! Hubs would leak into such a ranking from both ends, so each end is damped by a published measure:
+//! a shared neighbor contributes `1 / (its own neighborhood size)`, the Resource Allocation index, so
+//! a symbol everything touches certifies almost nothing; and the sum is divided by the size of the
+//! two neighborhoods' union, the Jaccard denominator, so a candidate cannot rank on the sheer breadth
+//! of its own references. Both are smooth functions of persisted counts — no threshold, no cap, no
+//! excluded kind.
+//!
+//! Scores are internal: they order the rank list this module emits and are then discarded, never
+//! serialized into any answer.
+
+use std::collections::HashMap;
+
+use crate::graph::store::GraphStore;
+use crate::identity::CanonicalId;
+
+/// Rank `subject`'s distance-2 candidates by degree-damped neighborhood overlap, most overlapping
+/// first, ties broken by canonical identity.
+///
+/// A candidate sharing no neighbor with the subject is absent from the list rather than ranked last:
+/// absence is how a rank list states that this signal has no opinion, which is exactly the claim for
+/// an isolated symbol or for a parallel implementation wired into another half of the workspace. A
+/// subject with no dependency edges at all therefore yields an empty list.
+///
+/// Determinism: the store returns the shared-neighbor rows in a fixed `(candidate, shared)` order and
+/// the sums accumulate in that order, so identical stores produce bit-identical scores and identical
+/// orders.
+pub fn neighborhood_ranks(store: &GraphStore, subject: &CanonicalId) -> rusqlite::Result<Vec<CanonicalId>> {
+    let subject_size = store.dependency_neighborhood(subject)?.len() as u64;
+    if subject_size == 0 {
+        return Ok(Vec::new());
+    }
+    let rows = store.shared_neighbors_of(subject)?;
+    if rows.is_empty() {
+        return Ok(Vec::new());
+    }
+    let candidate_sizes: HashMap<CanonicalId, u64> =
+        store.candidate_neighborhood_sizes(subject)?.into_iter().collect();
+
+    // The rows arrive grouped by candidate in identity order; each group's contributions accumulate
+    // in that same order, which is what fixes the floating-point summation.
+    let mut scored: Vec<(CanonicalId, f64)> = Vec::new();
+    let mut allocation = 0.0f64;
+    let mut shared_count = 0u64;
+    for (index, row) in rows.iter().enumerate() {
+        allocation += 1.0 / row.shared_neighborhood_size as f64;
+        shared_count += 1;
+        let group_ends = rows.get(index + 1).is_none_or(|next| next.candidate != row.candidate);
+        if group_ends {
+            // A candidate is adjacent to every neighbor it shares, so its neighborhood is at least
+            // the shared set; the clamp keeps the union at least the subject's neighborhood, and
+            // therefore positive, however the two aggregations were interleaved with a rebuild.
+            let candidate_size = candidate_sizes
+                .get(&row.candidate)
+                .copied()
+                .unwrap_or(0)
+                .max(shared_count);
+            let union = (subject_size + candidate_size - shared_count) as f64;
+            scored.push((row.candidate.clone(), allocation / union));
+            allocation = 0.0;
+            shared_count = 0;
+        }
+    }
+
+    scored.sort_by(|a, b| b.1.total_cmp(&a.1).then_with(|| a.0.as_str().cmp(b.0.as_str())));
+    Ok(scored.into_iter().map(|(id, _)| id).collect())
+}

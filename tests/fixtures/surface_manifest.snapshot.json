{
  "surface_version": 2,
  "help": "c10r <command> --help",
  "commands": [
    {
      "name": "get",
      "about": "Retrieve a symbol at a chosen detail level, by name or by source position",
      "args": [
        {
          "name": "reference",
          "required": false
        }
      ],
      "flags": [
        {
          "name": "detail",
          "takes_value": true,
          "values": [
            "location",
            "signature",
            "interface",
            "body"
          ],
          "default": "location",
          "global": false
        },
        {
          "name": "at",
          "takes_value": true,
          "global": false
        },
        {
          "name": "max-lines",
          "takes_value": true,
          "default": "100",
          "global": false
        },
        {
          "name": "from",
          "takes_value": true,
          "default": "1",
          "global": false
        },
        {
          "name": "limit",
          "takes_value": true,
          "default": "25",
          "global": false
        },
        {
          "name": "cursor",
          "takes_value": true,
          "global": false
        },
        {
          "name": "db",
          "takes_value": true,
          "default": ".c10r/index.db",
          "global": true
        },
        {
          "name": "workspace",
          "takes_value": true,
          "global": true
        },
        {
          "name": "json",
          "takes_value": false,
          "global": true
        },
        {
          "name": "color",
          "takes_value": true,
          "values": [
            "auto",
            "always",
            "never"
          ],
          "default": "auto",
          "global": true
        }
      ]
    },
